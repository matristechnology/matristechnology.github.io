---
// Üye kartı. Adı boş kayıt şablon olarak çizilir: "Üye 01", "Yakında".
// Ayrıntı (bölüm, bağlantı) betik kapalıyken açık durur. Betik varken kartın üstüne gelince,
// karta dokununca ya da düğmeye basınca açılır: hiçbir bilgi yalnızca fareyle erişilir değildir.
import { Image } from 'astro:assets';
import { icerik, c, uyeGorseli, type Dil, type Uye } from '../lib/icerik';
import { t } from '../lib/i18n';

interface Props { uye: Uye; dil: Dil; gecikme: number }
const { uye, dil, gecikme } = Astro.props;
const no = String(uye.sira).padStart(2, '0');
const ad = uye.sablon ? `${t('uyeSablon', dil)} ${no}` : uye.ad;
const basHarf = uye.ad.split(/\s+/).filter(Boolean).map((p) => p[0]).slice(0, 2).join('').toLocaleUpperCase('tr');
const gorev = c(uye.gorev, dil);
const bolum = c(uye.bolum, dil);
const ekip = uye.ekip ? c(icerik.ekipler[uye.ekip], dil) : '';
const ayrintiVar = !uye.sablon && !!(bolum || uye.baglanti);
const kimlik = `uye-${no}`;
---

<li class:list={['uye', { sablon: uye.sablon, sorumlu: uye.sorumlu }]} data-ekip={uye.ekip} data-belir style={`--i:${gecikme}`}>
  <div class="uye-foto" aria-hidden={uye.fotograf && !uye.sablon ? undefined : 'true'}>
    {!uye.sablon && uye.fotograf ? (
      <Image src={uyeGorseli(uye.fotograf)} alt={uye.ad} width={320} height={320} fit="cover" loading="lazy" />
    ) : uye.sablon ? (
      <svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M15 15l18 18M33 15 15 33"/><circle cx="11" cy="11" r="5.5"/><circle cx="37" cy="11" r="5.5"/><circle cx="11" cy="37" r="5.5"/><circle cx="37" cy="37" r="5.5"/><rect x="19" y="19" width="10" height="10" rx="2.5" fill="currentColor" stroke="none"/></svg>
    ) : (
      <span class="bas-harf">{basHarf}</span>
    )}
  </div>
  <div class="uye-yazi">
    <h3>{ad}</h3>
    {uye.sablon ? (
      <p class="uye-gorev"><span class="yakinda">{t('yakinda', dil)}</span><span class="gizli"> {t('sablonAciklama', dil)}</span></p>
    ) : (
      <>
        {gorev && <p class="uye-gorev">{gorev}</p>}
        {ekip && <p class="uye-ekip">{ekip}</p>}
      </>
    )}
    {ayrintiVar && (
      <>
        <button type="button" class="uye-ac js-only" aria-expanded="false" aria-controls={kimlik}>{t('ayrinti', dil)}<span class="gizli">: {ad}</span></button>
        <div class="uye-ayrinti" id={kimlik}>
          {bolum && <p>{bolum}</p>}
          {uye.baglanti && <p><a href={uye.baglanti} rel="noopener">{t('profil', dil)}<span class="gizli">: {ad}</span></a></p>}
        </div>
      </>
    )}
  </div>
</li>
