---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { icerik, c, gorunenBolumler, type Dil } from '../lib/icerik';
import { t, anaYol, digerDil, bolumler, altSayfa, type Bolum } from '../lib/i18n';

interface Props {
  dil: Dil;
  baslik: string;
  aciklama: string;
  /** Bu sayfanın öteki dildeki adresi */
  karsiYol: string;
  sayfa: 'ana' | 'diger';
  /** Ayrıntı sayfasında bulunulan bölüm: menüde işaretlenir. */
  bolum?: Bolum;
}
const { dil, baslik, aciklama, karsiYol, sayfa, bolum } = Astro.props;
const diger = digerDil(dil);
const site = icerik.site.adres;
const buAdres = new URL(Astro.url.pathname, site).href;
const karsiAdres = new URL(karsiYol, site).href;
const ogGorsel = new URL(`/og-${dil}.png`, site).href;
const ana = anaYol(dil);
const sira = gorunenBolumler();
// Ana sayfada menü bölümlere kayar. Ayrıntı sayfalarında, sayfası olan bölüm o sayfaya, öteki bölümler ana sayfadaki yerine gider.
// Ayrıntı sayfası olan başlık o sayfaya gider (Ali, 26.11.2026: "basılınca bu web siteleri açılsın").
// Sayfası henüz olmayan başlık (destek, iletişim) ana sayfadaki bölümüne iner.
const bag = (b: (typeof sira)[number]) => (altSayfa[b] ? altSayfa[b]![dil] : `${sayfa === 'ana' ? '' : ana}#${bolumler[b][dil]}`);
const anaBag = sayfa === 'ana' ? '#ust' : ana;
const ad = icerik.takim.ad;
---

<!doctype html>
<html lang={dil}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{baslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="canonical" href={buAdres} />
    <link rel="alternate" hreflang={dil} href={buAdres} />
    <link rel="alternate" hreflang={diger} href={karsiAdres} />
    <link rel="alternate" hreflang="x-default" href={dil === 'tr' ? buAdres : karsiAdres} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ad} />
    <meta property="og:title" content={baslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={buAdres} />
    <meta property="og:image" content={ogGorsel} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={dil === 'tr' ? 'tr_TR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={dil === 'tr' ? 'en_GB' : 'tr_TR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var s = localStorage.getItem('tema');
          if (s === 'light' || s === 'dark') d.dataset.theme = s;
          if (localStorage.getItem('suru') === 'kapali') d.dataset.suru = 'kapali';
        } catch (e) {}
        // Hareket yalnızca tarayıcı destekliyorsa ve ziyaretçi "hareketi azalt" demediyse açılır.
        // Betik bir nedenle çalışmazsa içerik gizli kalmasın diye sınıf geri alınır.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
          d.classList.add('anim');
          setTimeout(function () {
            if (!window.__hazir) d.classList.remove('anim');
          }, 2500);
        }
      })();
    </script>
  </head>
  <body data-sayfa={sayfa} data-dil={dil}>
    <a class="atla" href="#icerik">{t('icerigeGec', dil)}</a>
    <div class="ilerleme" aria-hidden="true"><span></span></div>

    <header class="ust">
      <div class="ust-ic kap">
        <a class="imza" href={sayfa === 'ana' ? '#ust' : ana} aria-label={ad}>
          <Image src={logo} alt="" width={132} height={52} loading="eager" />
        </a>

        <nav class="menu" aria-label={t('anaMenu', dil)}>
          <ul>
            <li><a href={anaBag} data-ana aria-current={sayfa === 'ana' ? 'page' : undefined}>{t('anaSayfaKisa', dil)}</a></li>
            {sira.map((b) => (
              <li><a href={bag(b)} data-bolum={altSayfa[b] ? undefined : bolumler[b][dil]} aria-current={bolum === b ? 'page' : undefined}>{t(b, dil)}</a></li>
            ))}
          </ul>
        </nav>

        <div class="araclar">
          <a class="dugme birincil kucuk ust-destek" href={bag('destek')}>{t('destekOl', dil)}</a>
          <button class="dugme-ikon suru-dugme js-only" type="button" data-suru-dugme aria-pressed="true" aria-label={t('suruDugme', dil)} title={t('suruDugme', dil)}>
            <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M7 7l10 10M17 7 7 17"/><circle cx="5.5" cy="5.5" r="2.6"/><circle cx="18.5" cy="5.5" r="2.6"/><circle cx="5.5" cy="18.5" r="2.6"/><circle cx="18.5" cy="18.5" r="2.6"/><rect x="9.6" y="9.6" width="4.8" height="4.8" rx="1.2" fill="currentColor" stroke="none"/></svg>
          </button>
          <a class="dil" href={karsiYol} hreflang={diger} lang={diger} data-dil-degistir aria-label={`TR / EN: ${t('dilDegistir', dil)}`}>
            <span aria-hidden="true" class:list={[{ secili: dil === 'tr' }]}>TR</span><span aria-hidden="true" class="ayrac">/</span><span aria-hidden="true" class:list={[{ secili: dil === 'en' }]}>EN</span>
          </a>
          <button class="dugme-ikon js-only" type="button" data-tema aria-label={t('temaDegistir', dil)} title={t('temaDegistir', dil)}>
            <svg class="ay" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <svg class="gunes" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
          <details class="mobil-menu">
            <summary aria-label={t('menu', dil)}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </summary>
            <ul>
              <li><a href={anaBag} aria-current={sayfa === 'ana' ? 'page' : undefined}>{t('anaSayfaKisa', dil)}</a></li>
              {sira.map((b) => (
                <li><a href={bag(b)} aria-current={bolum === b ? 'page' : undefined}>{t(b, dil)}</a></li>
              ))}
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main id="icerik">
      <slot />
    </main>

    <footer class="alt">
      <div class="kap alt-ic">
        <p>© {new Date().getFullYear()} {ad}. {t('altBilgi', dil)}</p>
        <p><a href={sayfa === 'ana' ? '#ust' : ana}>{t('yukari', dil)}</a></p>
      </div>
    </footer>

    <canvas class="suru js-only" data-suru data-etiket={dil === 'tr' ? 'sürü' : 'swarm'} data-onleme-adi={dil === 'tr' ? 'önleme' : 'intercept'} data-formasyonlar={dil === 'tr' ? 'V,halka,çizgi,kol,ok başı' : 'V,ring,line,column,arrowhead'} data-serbest={dil === 'tr' ? 'serbest' : 'free'} data-donus={dil === 'tr' ? 'dönüş' : 'yaw'} aria-hidden="true"></canvas>

    <script>
      import '../scripts/site.ts';
      import '../scripts/suru.ts';
      import '../scripts/demo-suru.ts';
    </script>
  </body>
</html>
