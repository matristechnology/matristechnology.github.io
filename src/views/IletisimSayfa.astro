---
// İletişim ayrıntı sayfası: kime hangi adresten ulaşılacağını gösteren kartlar ve üniversitenin haritadaki yeri.
// Anlatım icerik.yaml (iletisim_sayfa, iletisim). Telefon ve açık adres yazılmaz.
// Harita (OpenStreetMap) ancak bölüm ekrana yaklaşınca yüklenir, betik kapalıyken yerine bağlantılar durur.
import SayfaGecis from '../components/SayfaGecis.astro';
import Base from '../layouts/Base.astro';
import { icerik, c, type Dil } from '../lib/icerik';
import { t, anaYol, altSayfa, digerDil , sayfaBasligi } from '../lib/i18n';

interface Props { dil: Dil }
const { dil } = Astro.props;
const S = icerik.iletisim_sayfa, I = icerik.iletisim, K = S.kartlar, N = S.konum;
const kimlik = (k: string) => (dil === 'tr' ? k : { kartlar: 'reach', konum: 'where' }[k] ?? k);
const posta = (adres: string, konu: string) => `mailto:${adres}?subject=${encodeURIComponent(konu)}`;
const epostalar = [
  { anahtar: 'sponsor', adres: I.eposta, k: K.sponsor },
  { anahtar: 'takim', adres: I.takim_eposta, k: K.takim },
  { anahtar: 'kaptan', adres: I.kaptan_eposta, k: K.kaptan },
].filter((x) => x.adres);
const sosyal = [
  { anahtar: 'instagram', adres: I.instagram, gorunen: I.instagram_ad, k: K.instagram },
  { anahtar: 'linkedin', adres: I.linkedin, gorunen: '', k: K.linkedin },
];
const e = N.enlem, b = N.boylam, de = 0.006, db = 0.011;
const gomme = `https://www.openstreetmap.org/export/embed.html?bbox=${(b - db).toFixed(5)}%2C${(e - de).toFixed(5)}%2C${(b + db).toFixed(5)}%2C${(e + de).toFixed(5)}&layer=mapnik&marker=${e}%2C${b}`;
const buyuk = `https://www.openstreetmap.org/?mlat=${e}&mlon=${b}#map=16/${e}/${b}`;
const tarif = `https://www.google.com/maps/dir/?api=1&destination=${e}%2C${b}`;
---

<Base dil={dil} baslik={sayfaBasligi.iletisim[dil]} aciklama={c(S.ozet, dil)} karsiYol={altSayfa.iletisim[digerDil(dil)]} sayfa="diger" bolum="iletisim">
  <section class="sayfa-bas kap">
    <nav class="kirinti" aria-label={dil === 'tr' ? 'Konum' : 'Breadcrumb'}>
      <a href={anaYol(dil)}>{dil === 'tr' ? 'Ana sayfa' : 'Home'}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{c(S.baslik, dil)}</span>
    </nav>
    <h1 data-belir>{c(S.baslik, dil)}</h1>
    <p class="tanitim" data-belir style="--i:1">{c(S.ozet, dil)}</p>
  </section>

  <div data-iletisim data-kopyalandi={c(K.kopyalandi, dil)}>
  <section class="bolum kap" id={kimlik('kartlar')}>
    <h2 data-belir>{c(K.baslik, dil)}</h2>
    <ul class="ulas-kartlar">
      {epostalar.map((x, i) => (
        <li class="ulas-kart" data-belir style={`--i:${i}`} data-ulas={x.anahtar}>
          <strong>{c(x.k.ad, dil)}</strong>
          <p class="soluk">{c(x.k.metin, dil)}</p>
          <a class="ulas-adres" href={posta(x.adres, c(x.k.konu, dil))}>{x.adres}</a>
          <div class="dugmeler">
            <a class="dugme birincil kucuk" data-yaz href={posta(x.adres, c(x.k.konu, dil))}>{c(K.yaz, dil)}</a>
            <button class="dugme kucuk js-only" type="button" data-kopyala={x.adres} data-yazi={c(K.kopyala, dil)}>{c(K.kopyala, dil)}</button>
          </div>
        </li>
      ))}
      {sosyal.map((x, i) => (
        <li class:list={['ulas-kart', { bos: !x.adres }]} data-belir style={`--i:${epostalar.length + i}`} data-ulas={x.anahtar} data-ulas-sablon={x.adres ? undefined : ''}>
          <strong>{c(x.k.ad, dil)}</strong>
          <p class="soluk">{c(x.k.metin, dil)}</p>
          {x.adres
            ? <><span class="ulas-adres">{x.gorunen}</span><div class="dugmeler"><a class="dugme kucuk" href={x.adres} rel="noopener">{c(x.k.dugme, dil)}<span aria-hidden="true"> ↗</span></a></div></>
            : <span class="ulas-yakinda">{c(K.yakinda, dil)}</span>}
        </li>
      ))}
    </ul>
    <p class="ulas-durum js-only" role="status" data-kopya-durum></p>
  </section>

  <section class="bolum kap" id={kimlik('konum')}>
    <h2 data-belir>{c(N.baslik, dil)}</h2>
    <div class="konum" data-belir>
      <div class="konum-yazi">
        <p class="konum-ad"><strong>{c(N.ad, dil)}</strong><span class="soluk">{c(N.yer, dil)}</span></p>
        <p>{c(N.metin, dil)}</p>
        <div class="dugmeler">
          <a class="dugme birincil" data-tarif href={tarif} rel="noopener">{c(N.tarif, dil)}<span aria-hidden="true"> ↗</span></a>
          <a class="dugme" data-buyuk-harita href={buyuk} rel="noopener">{c(N.ac, dil)}<span aria-hidden="true"> ↗</span></a>
        </div>
      </div>
      <div class="harita js-only" data-harita data-src={gomme}>
        <span class="harita-igne" aria-hidden="true"></span>
        <iframe title={c(N.harita_ad, dil)} loading="lazy" referrerpolicy="no-referrer"></iframe>
      </div>
    </div>
  </section>
  </div>

  <section class="kap sayfa-son">
    <SayfaGecis dil={dil} bolum="iletisim" />
  </section>
</Base>

<script>
  import '../scripts/iletisim-sayfa.ts';
</script>
