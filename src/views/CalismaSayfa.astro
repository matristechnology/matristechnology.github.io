---
// Çalışmalar ayrıntı sayfası: tıklanan dört aşama, atölye, raporların nasıl hazırlandığı ve dereceler.
// Anlatım icerik.yaml (calisma_sayfa, basarilar). Aşamalar alt alta durur, sayfa kaydırıldıkça belirir ve yandaki çizgi dolar (calisma-sayfa.ts).
import { Image } from 'astro:assets';
import SayfaGecis from '../components/SayfaGecis.astro';
import Base from '../layouts/Base.astro';
import { icerik, c, galeriGorseli, type Dil } from '../lib/icerik';
import { t, anaYol, altSayfa, digerDil } from '../lib/i18n';

interface Props { dil: Dil }
const { dil } = Astro.props;
const S = icerik.calisma_sayfa, A = S.asamalar.liste;
const kimlik = (k: string) => (dil === 'tr' ? k : { asamalar: 'stages', atolye: 'workshop', rapor: 'reports' }[k] ?? k);
const y = {
  tr: { asama: 'Aşama', asamalar: 'Aşamalar', bakilan: 'Neye bakıyoruz', gecis: 'Sonraki aşamaya ne zaman geçiyoruz' },
  en: { asama: 'Stage', asamalar: 'Stages', bakilan: 'What we look at', gecis: 'When we move on' },
}[dil];
const foto = (f: string) => ({ kaynak: galeriGorseli(f), alt: c(icerik.galeri.find((g) => g.dosya === f)?.alt, dil) });
const icindekiler = [
  ['asamalar', c(S.asamalar.baslik, dil)],
  ...(S.atolye.goster ? [['atolye', c(S.atolye.baslik, dil)]] : []),
  ['rapor', c(S.rapor.baslik, dil)],
];
---

<Base dil={dil} baslik={`${c(S.baslik, dil)} | ${icerik.takim.ustluk[dil]}`} aciklama={c(S.ozet, dil)} karsiYol={altSayfa.calismalar[digerDil(dil)]} sayfa="diger" bolum="calismalar">
  <section class="sayfa-bas kap">
    <nav class="kirinti" aria-label={dil === 'tr' ? 'Konum' : 'Breadcrumb'}>
      <a href={anaYol(dil)}>{dil === 'tr' ? 'Ana sayfa' : 'Home'}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{c(S.baslik, dil)}</span>
    </nav>
    <h1 data-belir>{c(S.baslik, dil)}</h1>
    <p class="tanitim" data-belir style="--i:1">{c(S.ozet, dil)}</p>
    <ol class="icindekiler" data-belir style="--i:2">
      {icindekiler.map(([k, ad], i) => <li><a href={`#${kimlik(k)}`}><span>{String(i + 1).padStart(2, '0')}</span>{ad}</a></li>)}
    </ol>
  </section>

  <section class="bolum kap" id={kimlik('asamalar')}>
    <h2 data-belir>{c(S.asamalar.baslik, dil)}</h2>
    <p class="bolum-giris" data-belir>{c(S.asamalar.giris, dil)}</p>
    <ol class="akis" data-akis>
      {A.map((a, i) => (
        <li class="akis-adim" data-adim>
          <span class="akis-nokta" aria-hidden="true">{i + 1}</span>
          <article class="akis-kart">
            <div class="asama-yazi" data-belir>
              <p class="hikaye-yil">{y.asama} {i + 1} / {A.length}</p>
              <h3>{c(a.ad, dil)}</h3>
              <p>{c(a.metin, dil)}</p>
              {c(a.gecis, dil) && <p class="asama-gecis"><strong>{y.gecis}</strong>{c(a.gecis, dil)}</p>}
            </div>
            <div class="asama-yan" data-belir style="--i:2">
              {a.fotograf && <Image src={foto(a.fotograf).kaynak} alt={foto(a.fotograf).alt} widths={[400, 800]} sizes="(min-width: 60rem) 24rem, 90vw" loading="lazy" />}
              {a.bakilan.length > 0 && (
                <div class="asama-bakilan">
                  <h4>{y.bakilan}</h4>
                  <ul>{a.bakilan.map((b) => <li>{c(b, dil)}</li>)}</ul>
                </div>
              )}
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>

  {S.atolye.goster && (
  <section class="bolum kap" id={kimlik('atolye')}>
      <h2 data-belir>{c(S.atolye.baslik, dil)}</h2>
      <div class="ortam">
        <div class="yazi genis-yazi" data-belir>
          {S.atolye.paragraflar.map((p) => <p>{c(p, dil)}</p>)}
        </div>
        {S.atolye.fotograflar.length > 0 && (
          <ul class="ortam-foto tek" data-belir>
            {S.atolye.fotograflar.map((f) => <li><Image src={foto(f).kaynak} alt={foto(f).alt} widths={[400, 800]} sizes="(min-width: 60rem) 26rem, 90vw" loading="lazy" /></li>)}
          </ul>
        )}
      </div>
    </section>
  )}

  <section class="bolum kap" id={kimlik('rapor')}>
    <h2 data-belir>{c(S.rapor.baslik, dil)}</h2>
    <div class="yazi genis-yazi" data-belir>
      {S.rapor.paragraflar.map((p) => <p>{c(p, dil)}</p>)}
    </div>
    <ol class="rapor-yol">
      {S.rapor.adimlar.map((a, i) => (
        <li data-belir style={`--i:${i}`}>
          <span class="surec-no" aria-hidden="true">{i + 1}</span>
          <h3>{c(a.ad, dil)}</h3>
          <p class="soluk">{c(a.metin, dil)}</p>
        </li>
      ))}
    </ol>
    <ul class="dereceler">
      {icerik.basarilar.map((b, i) => (
        <li data-belir style={`--i:${i}`} class:list={[{ derece: b.tur === 'derece' }]}>
          <span class="hikaye-yil">{b.yil}</span>
          <strong>{c(b.baslik, dil)}</strong>
          <span class="soluk">{c(b.ayrinti, dil)}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="kap sayfa-son">
    <SayfaGecis dil={dil} bolum="calismalar" />
  </section>
</Base>

<script>
  import '../scripts/calisma-sayfa.ts';
</script>
