---
// Sürü İHA ayrıntı sayfası. Anlatım icerik.yaml (suru_sayfa), benzetim metinleri src/lib/i18n-suru.ts,
// benzetimler src/scripts/suru-sayfa.ts. Betik kapalıyken her benzetimin yerinde yazılı anlatım kalır.
import Base from '../layouts/Base.astro';
import { icerik, c, type Dil } from '../lib/icerik';
import { t, anaYol, altSayfa, digerDil } from '../lib/i18n';
import { sm, paket, hepsi } from '../lib/i18n-suru';

interface Props { dil: Dil }
const { dil } = Astro.props;
const S = icerik.suru_sayfa;
const m = paket(dil, hepsi);
const roller = JSON.stringify(Object.fromEntries((['lider', 'takipci', 'yedek'] as const).map((r) => [r, { ad: c(S.roller[r].ad, dil), metin: c(S.roller[r].metin, dil), isler: S.roller[r].isler.map((i) => c(i, dil)) }])));
const icindekiler = [
  ['neden', c(S.neden[0]?.baslik, dil)],
  ['tarama', c(S.tarama.baslik, dil)],
  ['yarisma', c(S.yarisma.baslik, dil)],
  ['roller', c(S.roller.baslik, dil)],
  ['gorev', c(S.gorev.baslik, dil)],
  ['konsol', c(S.konsol.baslik, dil)],
  ['lider', c(S.lider.baslik, dil)],
  ['mesh', c(S.mesh.baslik, dil)],
  ['geometri', c(S.geometri.baslik, dil)],
] as const;
const kimlik = (k: string) => (dil === 'tr' ? k : { neden: 'why', tarama: 'survey', yarisma: 'competition', roller: 'roles', gorev: 'mission', konsol: 'console', lider: 'leader', geometri: 'geometry' }[k] ?? k);
const plan = [
  { ad: sm('adKalkis', dil), ozet: 'TAKEOFF' },
  { ad: 'QR 1', ozet: `${sm('V', dil)} · 8 m` },
  { ad: 'QR 3', ozet: dil === 'tr' ? 'irtifa 12 m' : 'altitude 12 m' },
  { ad: 'QR 4', ozet: dil === 'tr' ? 'öne 10°' : 'pitch 10°' },
  { ad: 'QR 5', ozet: dil === 'tr' ? 'İHA 2 ayrılır' : 'UAV 2 leaves' },
  { ad: 'QR 2', ozet: `${sm('OKBASI', dil)} · 8 m` },
  { ad: sm('adEv', dil), ozet: 'RETURN_HOME · LAND' },
];
---

<Base dil={dil} baslik={`${c(S.baslik, dil)} | ${icerik.takim.ad}`} aciklama={c(S.ozet, dil)} karsiYol={altSayfa.suru[digerDil(dil)]} sayfa="diger" bolum="suru">
  <section class="sayfa-bas kap">
    <nav class="kirinti" aria-label={dil === 'tr' ? 'Konum' : 'Breadcrumb'}>
      <a href={anaYol(dil)}>{dil === 'tr' ? 'Ana sayfa' : 'Home'}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{c(S.baslik, dil)}</span>
    </nav>
    <h1 data-belir>{c(S.baslik, dil)}</h1>
    <p class="tanitim" data-belir style="--i:1">{c(S.ozet, dil)}</p>
    <ol class="icindekiler" data-belir style="--i:2">
      {icindekiler.map(([k, ad], i) => <li><a href={`#${kimlik(k)}`}><span>{String(i + 1).padStart(2, '0')}</span>{ad}</a></li>)}
    </ol>
  </section>

  <!-- 1. Neden İHA, neden sürü -->
  <section class="bolum kap" id={kimlik('neden')}>
    <div class="neden">
      {S.neden.map((n, i) => (
        <article class="kutu" data-belir style={`--i:${i}`}>
          <h2 class="kutu-baslik">{c(n.baslik, dil)}</h2>
          <p>{c(n.metin, dil)}</p>
        </article>
      ))}
    </div>
    {S.cevaplar.length > 0 && (
      <dl class="cevaplar" data-belir>
        {S.cevaplar.map((x) => <div><dt>{c(x.soru, dil)}</dt><dd>{c(x.cevap, dil)}</dd></div>)}
      </dl>
    )}
  </section>

  <!-- 2. Alan tarama -->
  <section class="bolum kap" id={kimlik('tarama')}>
    <h2 data-belir>{c(S.tarama.baslik, dil)}</h2>
    <p class="bolum-giris" data-belir>{c(S.tarama.giris, dil)}</p>
    <div class="tarama js-only" data-tarama data-m={m}>
      <div class="tarama-ikili">
        {(['tek', 'suru'] as const).map((p) => (
          <div class="tarama-panel" data-panel={p}>
            <div class="tarama-bas">
              <span class="tarama-ad">{sm(p === 'tek' ? 'tTek' : 'tSuru', dil)}{p === 'suru' && <> · <span data-sayi-yaz>3</span> {dil === 'tr' ? 'İHA' : 'UAVs'}</>}</span>
              <span class="tarama-sure" data-sure>{dil === 'tr' ? '0,0' : '0.0'} s</span>
              <span class="tarama-oran" data-oran>%0</span>
            </div>
            <div class="sahne"><canvas role="img" aria-label={sm(p === 'tek' ? 'tAlanTek' : 'tAlanSuru', dil)}></canvas></div>
          </div>
        ))}
      </div>
      <div class="tarama-kumanda">
        <div class="demo-grup" role="group" aria-label={sm('tSayi', dil)}>
          <span class="demo-etiket">{sm('tSayi', dil)}</span>
          <button type="button" class="dugme kucuk kare" data-azalt aria-label={sm('tAzalt', dil)}>−</button>
          <span class="demo-sayi" data-sayi-yaz aria-live="polite">3</span>
          <button type="button" class="dugme kucuk kare" data-artir aria-label={sm('tArtir', dil)}>+</button>
        </div>
        <div class="demo-grup">
          <button type="button" class="dugme kucuk birincil" data-basla>{sm('basla', dil)}</button>
          <button type="button" class="dugme kucuk" data-dusur disabled>{sm('tDusur', dil)}</button>
          <button type="button" class="dugme kucuk" data-dusur-tek disabled>{sm('tDusurTek', dil)}</button>
        </div>
        <p class="demo-durum" role="status" data-durum></p>
      </div>
    </div>
    <details class="teknik" data-belir><summary>{sm('teknik', dil)}</summary>{S.tarama.teknik.map((x) => <p>{c(x, dil)}</p>)}</details>
  </section>

  <!-- 3. Yarışma -->
  <section class="bolum kap" id={kimlik('yarisma')}>
    <h2 data-belir>{c(S.yarisma.baslik, dil)}</h2>
    <p class="bolum-giris" data-belir>{c(S.yarisma.giris, dil)}</p>
    <div class="gorevler">
      {S.yarisma.gorevler.map((g, i) => (
        <article class="kutu" data-belir style={`--i:${i}`}>
          <h3>{c(g.baslik, dil)}</h3>
          <ul class="madde">{g.maddeler.map((x) => <li>{c(x, dil)}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <!-- 4. Roller -->
  <section class="bolum kap" id={kimlik('roller')}>
    <h2 data-belir>{c(S.roller.baslik, dil)}</h2>
    <p class="bolum-giris" data-belir>{c(S.roller.giris, dil)}</p>
    <div class="sahne-govde js-only" data-roller data-m={m} data-rol-metin={roller}>
      <div class="sahne">
        <canvas role="img" aria-label={sm('rAlan', dil)}></canvas>
        <button type="button" class="sahne-gorunum dugme-ikon" data-gorunum aria-label={sm('gorunum', dil)} title={sm('gorunum', dil)}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5"/></svg></button>
        <span class="sahne-ipucu" aria-hidden="true">{sm('surukle', dil)}</span>
      </div>
      <div class="demo-kumanda">
        <div class="demo-grup" role="group" aria-label={sm('rSec', dil)}>
          <span class="demo-etiket">{sm('rSec', dil)}</span>
          {[0, 1, 2, 3].map((i) => <button type="button" class="dugme kucuk" data-sec={i} aria-pressed={i === 0 ? 'true' : 'false'}></button>)}
        </div>
        <div class="demo-grup"><button type="button" class="dugme kucuk" data-cagir>{sm('rCagir', dil)}</button></div>
        <div class="rol-panel" data-rol-panel></div>
        <p class="demo-durum" role="status" data-durum></p>
        <ul class="lejant">
          <li><i class="l-vurgu"></i>{sm('rYayin', dil)}</li>
          <li><i class="l-metin"></i>{sm('rBildirim', dil)}</li>
        </ul>
      </div>
    </div>
    <div class="js-yok roller-yazi">
      {(['lider', 'takipci', 'yedek'] as const).map((r) => (
        <div class="kutu"><h3>{c(S.roller[r].ad, dil)}</h3><p>{c(S.roller[r].metin, dil)}</p><ul class="madde">{S.roller[r].isler.map((x) => <li>{c(x, dil)}</li>)}</ul></div>
      ))}
    </div>
    <details class="teknik" data-belir><summary>{sm('teknik', dil)}</summary>{S.roller.teknik.map((x) => <p>{c(x, dil)}</p>)}</details>
  </section>

  <!-- 5. Görev 1 -->
  <section class="bolum kap" id={kimlik('gorev')}>
    <h2 data-belir>{c(S.gorev.baslik, dil)}</h2>
    <p class="bolum-giris" data-belir>{c(S.gorev.giris, dil)}</p>
    <div class="sahne-govde js-only" data-gorev data-m={m}>
      <div class="sahne genis">
        <canvas role="img" aria-label={sm('gAlan', dil)}></canvas>
        <button type="button" class="sahne-gorunum dugme-ikon" data-gorunum aria-label={sm('gorunum', dil)} title={sm('gorunum', dil)}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5"/></svg></button>
        <span class="sahne-ipucu" aria-hidden="true">{sm('surukle', dil)}</span>
      </div>
      <div class="demo-kumanda">
        <div class="demo-grup">
          <button type="button" class="dugme kucuk birincil" data-oynat aria-pressed="false">{sm('basla', dil)}</button>
          <button type="button" class="dugme kucuk" data-sonraki>{sm('gAdim', dil)}</button>
          <button type="button" class="dugme kucuk" data-bastan>{sm('bastan', dil)}</button>
        </div>
        <div class="demo-grup" role="group" aria-label={sm('gHiz', dil)}>
          <span class="demo-etiket">{sm('gHiz', dil)}</span>
          {[1, 2, 4].map((h) => <button type="button" class="dugme kucuk" data-hiz={h} aria-pressed={h === 1 ? 'true' : 'false'}>{h}×</button>)}
        </div>
        <p class="demo-durum" role="status" data-durum></p>
        <ol class="adimlar" aria-label={sm('gAdimlar', dil)}>
          {plan.map((p) => <li data-adim><span>{p.ad}</span><small>{p.ozet}</small></li>)}
        </ol>
      </div>
      <div class="qr-panel">
        <h3 class="demo-etiket">{sm('gQr', dil)}</h3>
        <p data-qr-oku></p>
        <pre data-qr-json></pre>
        <p class="demo-not">{sm('gOrnek', dil)}</p>
      </div>
    </div>
    <details class="teknik" data-belir><summary>{sm('teknik', dil)}</summary>{S.gorev.teknik.map((x) => <p>{c(x, dil)}</p>)}</details>
  </section>

  <!-- 6. Komut konsolu -->
  <section class="bolum kap" id={kimlik('konsol')}>
    <h2 data-belir>{c(S.konsol.baslik, dil)}</h2>
    <p class="bolum-giris" data-belir>{c(S.konsol.giris, dil)}</p>
    <div class="sahne-govde js-only" data-konsol data-m={m}>
      <div class="sahne">
        <canvas role="img" aria-label={sm('kAlan', dil)}></canvas>
        <button type="button" class="sahne-gorunum dugme-ikon" data-gorunum aria-label={sm('gorunum', dil)} title={sm('gorunum', dil)}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5"/></svg></button>
        <span class="sahne-ipucu" aria-hidden="true">{sm('surukle', dil)}</span>
      </div>
      <div class="demo-kumanda konsol">
        <div class="demo-grup" role="group" aria-label={sm('kTum', dil)}>
          <span class="demo-etiket">{sm('kTum', dil)}</span>
          <button type="button" class="dugme kucuk kod" data-k="TAKEOFF">TAKEOFF</button>
          <button type="button" class="dugme kucuk kod" data-k="FORMATION" data-arg="CIZGI">FORMATION · {sm('CIZGI', dil)}</button>
          <button type="button" class="dugme kucuk kod" data-k="FORMATION" data-arg="V">FORMATION · V</button>
          <button type="button" class="dugme kucuk kod" data-k="FORMATION" data-arg="OKBASI">FORMATION · {sm('OKBASI', dil)}</button>
          <button type="button" class="dugme kucuk kod" data-k="ALTITUDE" data-arg="2">ALTITUDE {sm('kYukari', dil)}</button>
          <button type="button" class="dugme kucuk kod" data-k="ALTITUDE" data-arg="-2">ALTITUDE {sm('kAsagi', dil)}</button>
          <button type="button" class="dugme kucuk kod" data-k="PITCH_ROLL" data-arg="10,0">PITCH_ROLL · {sm('kOne', dil)}</button>
          <button type="button" class="dugme kucuk kod" data-k="PITCH_ROLL" data-arg="0,10">PITCH_ROLL · {sm('kYana', dil)}</button>
          <button type="button" class="dugme kucuk kod" data-k="PITCH_ROLL" data-arg="0,0">PITCH_ROLL · {sm('kDuz', dil)}</button>
          <button type="button" class="dugme kucuk kod" data-k="RETURN_HOME">RETURN_HOME</button>
          <button type="button" class="dugme kucuk kod" data-k="LAND">LAND</button>
          <button type="button" class="dugme kucuk kod" data-k="DISARM">DISARM</button>
        </div>
        <div class="demo-grup" role="group" aria-label={sm('kTek', dil)}>
          <span class="demo-etiket">{sm('kTek', dil)}</span>
          <button type="button" class="dugme kucuk kod" data-k="SEPARATE" data-arg="r">SEPARATE · {sm('kKirmizi', dil)}</button>
          <button type="button" class="dugme kucuk kod" data-k="SEPARATE" data-arg="b">SEPARATE · {sm('kMavi', dil)}</button>
          <button type="button" class="dugme kucuk kod" data-k="STAY_GROUNDED">STAY_GROUNDED</button>
          <button type="button" class="dugme kucuk kod" data-k="SUBSTITUTE">SUBSTITUTE</button>
          <button type="button" class="dugme kucuk kod" data-k="REJOIN_APPROVED">REJOIN_APPROVED</button>
          <button type="button" class="dugme kucuk" data-bastan>{sm('bastan', dil)}</button>
        </div>
        <p class="demo-durum" role="status" data-durum></p>
        <div>
          <span class="demo-etiket">{sm('kPaket', dil)}</span>
          <pre class="paket" data-paket></pre>
        </div>
      </div>
    </div>
    <details class="teknik" data-belir><summary>{sm('teknik', dil)}</summary>{S.konsol.teknik.map((x) => <p>{c(x, dil)}</p>)}</details>
  </section>

  <!-- 7. Lider düşerse -->
  <section class="bolum kap" id={kimlik('lider')}>
    <h2 data-belir>{c(S.lider.baslik, dil)}</h2>
    <p class="bolum-giris" data-belir>{c(S.lider.giris, dil)}</p>
    <div class="sahne-govde js-only" data-lider-sahne data-m={m}>
      <div class="sahne">
        <canvas role="img" aria-label={sm('lAlan', dil)}></canvas>
        <button type="button" class="sahne-gorunum dugme-ikon" data-gorunum aria-label={sm('gorunum', dil)} title={sm('gorunum', dil)}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5"/></svg></button>
        <span class="sahne-ipucu" aria-hidden="true">{sm('surukle', dil)}</span>
      </div>
      <div class="demo-kumanda">
        <div class="demo-grup">
          <button type="button" class="dugme kucuk" data-ariza>{sm('lAriza', dil)}</button>
          <button type="button" class="dugme kucuk" data-devir>{sm('lDevir', dil)}</button>
          <button type="button" class="dugme kucuk" data-bastan>{sm('bastan', dil)}</button>
        </div>
        <div class="sayaclar">
          <span class="demo-etiket">{sm('lSayac', dil)}</span>
          {[1, 2].map((id) => (
            <div class="sayac">
              <span>{dil === 'tr' ? 'İHA' : 'UAV'} {id}</span>
              <span class="cubuk" data-cubuk aria-hidden="true"><i></i></span>
              <span data-sayac>0.0 s</span>
              <small>{sm('lSinir', dil).replace('{s}', String(5 + id))}</small>
            </div>
          ))}
        </div>
        <p class="demo-durum" role="status" data-durum></p>
        <pre class="paket" data-paket></pre>
      </div>
    </div>
    <details class="teknik" data-belir><summary>{sm('teknik', dil)}</summary>{S.lider.teknik.map((x) => <p>{c(x, dil)}</p>)}</details>
  </section>

  <!-- Mesh ağ -->
  <section class="bolum kap" id={kimlik('mesh')}>
    <h2 data-belir>{c(S.mesh.baslik, dil)}</h2>
    <p class="bolum-giris" data-belir>{c(S.mesh.giris, dil)}</p>
    <div class="sahne-govde js-only" data-mesh data-m={m}>
      <div class="sahne">
        <canvas role="img" aria-label={sm('mAlan', dil)}></canvas>
        <button type="button" class="sahne-gorunum dugme-ikon" data-gorunum aria-label={sm('gorunum', dil)} title={sm('gorunum', dil)}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5"/></svg></button>
        <span class="sahne-ipucu" aria-hidden="true">{sm('surukle', dil)}</span>
      </div>
      <div class="demo-kumanda">
        <div class="demo-grup" role="group" aria-label={sm('mSec', dil)}>
          <span class="demo-etiket">{sm('mSec', dil)}</span>
          {[1, 2, 3, 4].map((i) => <button type="button" class="dugme kucuk" data-sec={i} aria-pressed={i === 4 ? 'true' : 'false'}>{dil === 'tr' ? 'İHA' : 'UAV'} {i}</button>)}
        </div>
        <div class="demo-grup">
          <button type="button" class="dugme kucuk birincil" data-uzak>{sm('mUzak', dil)}</button>
          <button type="button" class="dugme kucuk" data-yakin>{sm('mYakin', dil)}</button>
        </div>
        <div class="demo-grup">
          <button type="button" class="dugme kucuk" data-zincir>{sm('mZincir', dil)}</button>
          <button type="button" class="dugme kucuk" data-sifirla>{sm('mSifirla', dil)}</button>
        </div>
        <p class="demo-durum" role="status" data-durum></p>
        <ul class="lejant">
          <li><i class="l-vurgu"></i>{sm('mYol', dil)}</li>
          <li><i class="l-metin"></i>{sm('mBag', dil)}</li>
        </ul>
      </div>
    </div>
    <details class="teknik" data-belir><summary>{sm('teknik', dil)}</summary>{S.mesh.teknik.map((x) => <p>{c(x, dil)}</p>)}</details>
  </section>

  <!-- 8. Geometri -->
  <section class="bolum kap" id={kimlik('geometri')}>
    <h2 data-belir>{c(S.geometri.baslik, dil)}</h2>
    <p class="bolum-giris" data-belir>{c(S.geometri.giris, dil)}</p>
    <div class="sahne-govde js-only" data-geometri data-m={m}>
      <div class="sahne">
        <canvas role="img" aria-label={sm('ggAlan', dil)}></canvas>
        <button type="button" class="sahne-gorunum dugme-ikon" data-gorunum aria-label={sm('gorunum', dil)} title={sm('gorunum', dil)}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5"/></svg></button>
        <span class="sahne-ipucu" aria-hidden="true">{sm('surukle', dil)}</span>
      </div>
      <div class="demo-kumanda">
        <div class="demo-grup" role="group" aria-label={t('dizilim', dil)}>
          <span class="demo-etiket">{t('dizilim', dil)}</span>
          {(['CIZGI', 'V', 'OKBASI'] as const).map((d) => <button type="button" class="dugme kucuk" data-tip={d} aria-pressed={d === 'V' ? 'true' : 'false'}>{sm(d, dil)}</button>)}
        </div>
        <div class="demo-grup" role="group" aria-label={sm('ggSayi', dil)}>
          <span class="demo-etiket">{sm('ggSayi', dil)}</span>
          <button type="button" class="dugme kucuk kare" data-azalt aria-label={t('azalt', dil)}>−</button>
          <span class="demo-sayi" data-sayi-yaz aria-live="polite">5</span>
          <button type="button" class="dugme kucuk kare" data-artir aria-label={t('artir', dil)}>+</button>
        </div>
        {([['yon', 'ggYon', 0, 355, 5, 90], ['aralik', 'ggAralik', 4, 12, 1, 8], ['pitch', 'ggPitch', -15, 15, 1, 0], ['roll', 'ggRoll', -15, 15, 1, 0]] as const).map(([ad, et, min, max, adim, deger]) => (
          <div class="kaydirici">
            <label for={`g-${ad}`}>{sm(et, dil)}</label>
            <input type="range" id={`g-${ad}`} data-g={ad} min={min} max={max} step={adim} value={deger} />
            <output for={`g-${ad}`}></output>
          </div>
        ))}
      </div>
      <div class="tablo-kap">
        <table class="yuvalar">
          <thead><tr><th scope="col">{sm('ggYuva', dil)}</th><th scope="col">{sm('ggYerel', dil)}</th><th scope="col">{sm('ggDunya', dil)}</th><th scope="col">{sm('ggIrtifa', dil)}</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
